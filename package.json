{
  "name": "anti-slop-engineering",
  "version": "1.6.0",
  "description": "An Engineering Discipline Playbook, Agent Skill & Triage Guard for AI Coding Agents",
  "type": "module",
  "main": "bin/cli.js",
  "bin": {
    "anti-slop-engineering": "bin/cli.js",
    "diff-guard": "bin/cli.js",
    "sre-guard": "bin/cli.js",
    "rust-guard": "bin/cli.js",
    "toil-guard": "bin/cli.js",
    "exec-guard": "bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imMamdouhaboammar/anti-slop-engineering.git"
  },
  "bugs": {
    "url": "https://github.com/imMamdouhaboammar/anti-slop-engineering/issues"
  },
  "homepage": "https://github.com/imMamdouhaboammar/anti-slop-engineering#readme",
  "files": [
    "bin",
    "dist",
    "scripts",
    "cases",
    "schemas",
    "skills",
    "services/anti-slop-rust/Cargo.toml",
    "services/anti-slop-rust/Cargo.lock",
    "services/anti-slop-rust/clippy.toml",
    "services/anti-slop-rust/src",
    "services/toil-guard-go/go.mod",
    "services/toil-guard-go/cmd",
    "services/toil-guard-go/pkg",
    "references",
    "assets",
    "SKILL.md",
    "marketplace.json",
    ".skills.json",
    "install.sh",
    "action.yml",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "bun bin/cli.js",
    "postinstall": "node bin/postinstall.js",
    "build": "bun bin/cli.js build",
    "rust": "bun bin/cli.js rust",
    "toil": "bun bin/cli.js toil",
    "guard": "bun bin/cli.js --base HEAD",
    "sre": "bun bin/cli.js sre",
    "sre-guard": "bun bin/cli.js sre",
    "exec": "bun bin/cli.js exec",
    "cases": "bun bin/cli.js cases",
    "contrast": "bun bin/cli.js contrast",
    "pr-guard": "bun bin/cli.js pr-guard",
    "honeypot": "bun bin/cli.js honeypot",
    "comment-guard": "bun bin/cli.js comment-guard",
    "attention": "bun bin/cli.js attention",
    "cognitive": "bun bin/cli.js attention",
    "steward": "bun bin/cli.js steward",
    "invariant": "bun bin/cli.js invariant",
    "audit": "bun bin/cli.js audit",
    "install-agents": "bun bin/cli.js install",
    "test": "python3 -m unittest discover -s tests -v",
    "test-all": "make test-all",
    "bump": "python3 scripts/bump_version.py",
    "oxlint": "oxlint",
    "lint:oxlint": "oxlint",
    "ruff": "ruff check .",
    "lint:ruff": "ruff check .",
    "lint:py": "ruff check .",
    "lint:fix": "ruff check --fix .",
    "format:ruff": "ruff format .",
    "clippy": "make clippy",
    "lint:rust": "make clippy",
    "install:clippy": "make install-clippy",
    "lint:all": "make lint && bun run lint:oxlint && bun run lint:rust",
    "check": "make check",
    "check-all": "make check-all",
    "security:audit": "bun run scripts/security-audit.ts"
  },
  "keywords": [
    "agent-skill",
    "anti-slop",
    "code-quality",
    "code-review",
    "skills.sh",
    "claude-code",
    "cursor",
    "codex",
    "gemini",
    "antigravity",
    "software-engineering",
    "bun",
    "sre",
    "site-reliability-engineering",
    "kiss",
    "dry",
    "yagni",
    "toil-elimination",
    "repo-memory",
    "invariant-steward",
    "architectural-memory"
  ],
  "author": "Mamdouh Aboammar <mamdouhfces1997@gmail.com> (https://github.com/imMamdouhaboammar)",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "oxlint": "1.93.0"
  }
}
