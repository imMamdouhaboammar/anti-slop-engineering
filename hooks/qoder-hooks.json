{
  "_comment": "Loaded live by .qoder-plugin/plugin.json. Qoder expands ${QODER_PLUGIN_ROOT} at runtime.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${QODER_PLUGIN_ROOT}/hooks/anti-slop-activate.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "task|Task|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${QODER_PLUGIN_ROOT}/hooks/anti-slop-subagent.js\""
          }
        ]
      }
    ]
  }
}
