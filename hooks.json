{
  "anti-slop-lifecycle": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node \"hooks/hook_dispatch.mjs\" SessionStart",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node \"hooks/hook_dispatch.mjs\" PreInvocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|Write|Edit|MultiEdit|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node \"hooks/hook_dispatch.mjs\" PreToolUse write",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|Write|Edit|MultiEdit|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node \"hooks/hook_dispatch.mjs\" PostToolUse write",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
